<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_card"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Top Client Color Accent Strip -->
    <ImageView
        android:id="@+id/widget_accent_bar"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginBottom="8dp"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/bg_widget_accent_bar" />

    <!-- Header with Client Switcher Arrows -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_client_dot"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:contentDescription="@null"
            android:src="@drawable/bg_widget_dot" />

        <TextView
            android:id="@+id/widget_client_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_empty_title"
            android:textAlignment="textStart"
            android:textColor="#14171A"
            android:textDirection="firstStrong"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/widget_btn_prev"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/bg_widget_pill"
            android:contentDescription="@string/widget_prev_client_cd"
            android:padding="3dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_widget_prev" />

        <ImageButton
            android:id="@+id/widget_btn_next"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_widget_pill"
            android:contentDescription="@string/widget_next_client_cd"
            android:padding="3dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_widget_next" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_task_counter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_empty_body"
            android:textColor="#525A63"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_client_index"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#7B848E"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Empty State -->
    <TextView
        android:id="@+id/widget_empty_text"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/widget_no_tasks"
        android:textColor="#7B848E"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- Up to 3 Task Rows -->
    <LinearLayout
        android:id="@+id/widget_task_row_0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:background="@drawable/bg_widget_task_row"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="7dp"
        android:paddingVertical="6dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/widget_task_priority_0"
            android:layout_width="3dp"
            android:layout_height="14dp"
            android:layout_marginEnd="5dp"
            android:contentDescription="@null"
            android:src="@drawable/bg_widget_priority_high"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/widget_task_check_0"
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:contentDescription="@string/widget_toggle_task_cd"
            android:src="@drawable/ic_widget_check_off" />

        <TextView
            android:id="@+id/widget_task_title_0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAlignment="textStart"
            android:textColor="#14171A"
            android:textDirection="firstStrong"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_task_row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:background="@drawable/bg_widget_task_row"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="7dp"
        android:paddingVertical="6dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/widget_task_priority_1"
            android:layout_width="3dp"
            android:layout_height="14dp"
            android:layout_marginEnd="5dp"
            android:contentDescription="@null"
            android:src="@drawable/bg_widget_priority_high"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/widget_task_check_1"
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:contentDescription="@string/widget_toggle_task_cd"
            android:src="@drawable/ic_widget_check_off" />

        <TextView
            android:id="@+id/widget_task_title_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAlignment="textStart"
            android:textColor="#14171A"
            android:textDirection="firstStrong"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_task_row_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:background="@drawable/bg_widget_task_row"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="7dp"
        android:paddingVertical="6dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/widget_task_priority_2"
            android:layout_width="3dp"
            android:layout_height="14dp"
            android:layout_marginEnd="5dp"
            android:contentDescription="@null"
            android:src="@drawable/bg_widget_priority_high"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/widget_task_check_2"
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:contentDescription="@string/widget_toggle_task_cd"
            android:src="@drawable/ic_widget_check_off" />

        <TextView
            android:id="@+id/widget_task_title_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAlignment="textStart"
            android:textColor="#14171A"
            android:textDirection="firstStrong"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_more_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="end"
        android:textColor="#7B848E"
        android:textSize="10sp"
        android:textStyle="bold"
        android:visibility="gone" />
</LinearLayout>
